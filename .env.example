FLASK_ENV=production
SECRET_KEY=
DATABASE_URL=sqlite:///transport_erp.db
HOST=0.0.0.0
PORT=5000
ADMIN_PASSWORD=Terry@2001

# --- Multi-site sync (only relevant for a local-server "spoke" PC) ---
# Leave SYNC_ENABLED=false (or unset) on the central/Render deployment —
# it only ever serves /api/sync/push and /api/sync/pull, it never runs
# the sync loop itself.
SITE_ID=central
SYNC_ENABLED=false
# SYNC_HUB_URL=https://transport-financial-system.onrender.com
# SYNC_API_KEY=  # from: python provision_sync_site.py <site_id>
SYNC_INTERVAL_SECONDS=60
# How often a spoke checks the hub for a newer published build (see
# SPOKE_SETUP.md, "Keeping the spoke up to date automatically"). Applied
# on the spoke's next restart, not immediately — no rush, so this is
# deliberately much coarser than SYNC_INTERVAL_SECONDS above.
SPOKE_UPDATE_CHECK_SECONDS=21600

# --- WhatsApp Report Bot (Meta WhatsApp Cloud API) ---
# From your Meta App Dashboard > WhatsApp > API Setup.
# WHATSAPP_VERIFY_TOKEN is any string you choose yourself — enter the same
# value when registering the webhook URL in the dashboard.
# WHATSAPP_APP_SECRET enables signature verification on inbound webhook
# calls; leave unset only for local testing.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
